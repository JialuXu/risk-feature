        <mxCell id="outArrow2" style="endArrow=block;html=1;rounded=0;strokeColor=#fb923c;strokeWidth=2;" edge="1" parent="1" source="step3" target="out2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="outArrow3" style="endArrow=block;html=1;rounded=0;strokeColor=#fb923c;strokeWidth=2;" edge="1" parent="1" source="step4" target="out3">
          <mxGeometry relative="1" as="geometry"/>
