        <mxCell id="out3" value="客户预警名单&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;谁触碰、触碰什么、怎么跟进&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb923c;fontSize=15;fontStyle=1;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="560" width="200" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="out4" value="汇报材料&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;图表、结论、Word 报告&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb923c;fontSize=15;fontStyle=1;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="875" y="560" width="200" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="outArrow1" style="endArrow=block;html=1;rounded=0;strokeColor=#fb923c;strokeWidth=2;" edge="1" parent="1" source="step3" target="out1">
          <mxGeometry relative="1" as="geometry"/>
