        <mxCell id="out1" value="重点风险因素&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;哪些指标值得重点盯&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb923c;fontSize=15;fontStyle=1;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="170" y="560" width="200" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="out2" value="分群风险画像&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;哪些行业、规模、分行更突出&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb923c;fontSize=15;fontStyle=1;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="405" y="560" width="200" height="85" as="geometry"/>
