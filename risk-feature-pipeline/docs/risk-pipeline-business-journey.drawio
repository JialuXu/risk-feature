<mxfile host="app.diagrams.net" modified="2026-04-29T06:00:00.000Z" agent="Cursor" version="24.7.17" type="device">
  <diagram id="risk-pipeline-business-journey" name="业务人员版-风险体检路线图">
    <mxGraphModel dx="1280" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fed7aa;strokeWidth=2;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="25" width="1220" height="710" as="geometry"/>
        </mxCell>
        <mxCell id="title" value="客户风险体检路线图" style="text;html=1;strokeColor=none;fillColor=none;fontSize=34;fontStyle=1;fontColor=#7c2d12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="45" width="600" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="不用看代码，也不用懂模型；只要把客户资料放进来，就能看到风险重点、重点客群和可跟进名单" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#9a3412;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="230" y="92" width="820" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="person" value="业务同事" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=16;fontStyle=1;fontColor=#111827;strokeColor=#374151;fillColor=#fef3c7;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="70" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="bubble" value="我想知道：&lt;br&gt;&lt;b&gt;哪些客户更值得关注？&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;fontSize=15;fontColor=#111827;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="150" width="190" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="step1" value="&lt;b&gt;1. 放入资料篮&lt;/b&gt;&lt;br&gt;&lt;br&gt;客户宽表&lt;br&gt;坏客户名单&lt;br&gt;分群字段&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;例如企业规模、行业、分行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=16;fontColor=#111827;align=center;verticalAlign=middle;spacing=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="215" y="285" width="180" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="step1Icon" value="资料篮" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#bfdbfe;strokeColor=#1d4ed8;fontSize=14;fontStyle=1;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="260" y="246" width="90" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="step2" value="&lt;b&gt;2. 自动做体检&lt;/b&gt;&lt;br&gt;&lt;br&gt;看每个指标&lt;br&gt;和坏客户的关系&lt;br&gt;找出异常特征&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;系统自动计算，不需要手工筛表&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=16;fontColor=#111827;align=center;verticalAlign=middle;spacing=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="455" y="285" width="180" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="step2Icon" value="体检台" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#bbf7d0;strokeColor=#15803d;fontSize=14;fontStyle=1;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="500" y="246" width="90" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="step3" value="&lt;b&gt;3. 生成风险地图&lt;/b&gt;&lt;br&gt;&lt;br&gt;哪些因素最重要&lt;br&gt;哪些客群更敏感&lt;br&gt;哪些组合更危险&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;让风险重点一眼可见&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontSize=16;fontColor=#111827;align=center;verticalAlign=middle;spacing=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="695" y="285" width="180" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="step3Icon" value="风险地图" style="shape=card;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#a16207;fontSize=14;fontStyle=1;fontColor=#713f12;" vertex="1" parent="1">
          <mxGeometry x="740" y="246" width="90" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="step4" value="&lt;b&gt;4. 形成预警名单&lt;/b&gt;&lt;br&gt;&lt;br&gt;客户触碰了什么风险&lt;br&gt;触碰多少条&lt;br&gt;风险分大概多高&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;便于客户经理逐户跟进&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=16;fontColor=#111827;align=center;verticalAlign=middle;spacing=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="935" y="285" width="180" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="step4Icon" value="预警清单" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fecaca;strokeColor=#b91c1c;fontSize=14;fontStyle=1;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="980" y="246" width="90" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="arrow12" style="endArrow=block;html=1;rounded=0;strokeColor=#92400e;strokeWidth=3;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow23" style="endArrow=block;html=1;rounded=0;strokeColor=#92400e;strokeWidth=3;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow34" style="endArrow=block;html=1;rounded=0;strokeColor=#92400e;strokeWidth=3;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrowPerson" style="endArrow=block;html=1;rounded=0;strokeColor=#92400e;strokeWidth=2;dashed=1;" edge="1" parent="1" source="bubble" target="step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="outputTitle" value="最终交付给业务看的东西" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#7c2d12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="505" width="440" height="36" as="geometry"/>
